generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name      String     @unique @db.VarChar(80)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  menuItems MenuItem[]

  @@map("categories")
}

model Table {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  code           String      @unique @db.VarChar(30)
  name           String      @db.VarChar(80)
  area           String      @default("Indoor") @db.VarChar(80)
  seats          Int         @default(2)
  status         TableStatus @default(available)
  qrToken        String      @unique @map("qr_token") @db.VarChar(120)
  scansToday     Int         @default(0) @map("scans_today")
  currentOrderId BigInt?     @map("current_order_id") @db.UnsignedBigInt
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orders         Order[]

  @@map("tables")
}

model MenuItem {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId   BigInt      @map("category_id") @db.UnsignedBigInt
  name         String      @db.VarChar(140)
  description  String?     @db.Text
  price        Decimal     @db.Decimal(12, 2)
  oldPrice     Decimal?    @map("old_price") @db.Decimal(12, 2)
  imageUrl     String?     @map("image_url") @db.VarChar(500)
  isAvailable  Boolean     @default(true) @map("is_available")
  isBestSeller Boolean     @default(false) @map("is_best_seller")
  badge        String?     @db.VarChar(40)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  category     Category    @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]

  @@map("menu_items")
}

model Order {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  orderNumber   String      @unique @map("order_number") @db.VarChar(40)
  tableId       BigInt?     @map("table_id") @db.UnsignedBigInt
  customerName  String      @map("customer_name") @db.VarChar(120)
  type          OrderType   @default(dine_in)
  status        OrderStatus @default(pending)
  source        OrderSource @default(manual)
  guests        Int         @default(1)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  tax           Decimal     @default(0) @db.Decimal(12, 2)
  serviceCharge Decimal     @default(0) @map("service_charge") @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  table         Table?      @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@map("orders")
}

model OrderItem {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId    BigInt   @map("order_id") @db.UnsignedBigInt
  menuItemId BigInt   @map("menu_item_id") @db.UnsignedBigInt
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt        @map("order_id") @db.UnsignedBigInt
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(pending)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  order     Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum Role {
  owner
  kasir
  waiters
}

enum TableStatus {
  available
  occupied
  preparing
  ready
  waiting_payment
  need_waiter
  inactive
}

enum OrderType {
  dine_in
  takeaway
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  served
  waiting_payment
  paid
  cancelled
}

enum OrderSource {
  qr
  manual
}

enum PaymentMethod {
  cash
  qris
  transfer
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}
