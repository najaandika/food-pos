# Contoh konfigurasi SAJA. Gabungkan nilai DB_* ke backend/.env
# setelah membuat database BARU bernama food_pos_laravel_dev.
# Jangan pernah arahkan DB_DATABASE ke database POS Next.js lama.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=food_pos_laravel_dev
DB_USERNAME=root
DB_PASSWORD=